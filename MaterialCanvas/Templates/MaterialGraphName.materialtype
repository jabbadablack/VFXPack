{
    "description": "Lit, height-displaced OpenParticleSystem meshes",
    "version": 5,
    "versionUpdates": [
        {
            "toVersion": 5,
            "actions": []
        }
    ],
    "propertyLayout": {
        "propertyGroups": [
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/BaseColorPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/VertexColorPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/MetallicPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/RoughnessPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/SpecularPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/NormalPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/OcclusionPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/UvPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/EmissivePropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/ClearCoatPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/ParallaxPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/OpacityPropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/IrradiancePropertyGroup.json"
            },
            {
                "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/GeneralCommonPropertyGroup.json"
            },
            {
                "name": "effect",
                "displayName": "Particle Surface",
                "description": "Mesh surface shaping and animated flow.",
                "properties": [
                    {
                        "name": "style",
                        "displayName": "Surface family",
                        "description": "0 neutral, 1 combustion, 2 vapor, 3 crystal, 4 liquid, 5 plasma, 6 energy shield, 7 cinder, 8 beam sheath, 9 flame tongue, 10 glass rim, 11 hot gas, 12 rising flame, 13 rolling fire front, 14 rolling cap, 15 sustained flame plume, 16 scattering cloud, 17 radial fire front, 18 radial smoke front.",
                        "type": "Float",
                        "defaultValue": 0.0,
                        "min": 0.0,
                        "max": 18.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectStyle"
                        }
                    },
                    {
                        "name": "flow",
                        "displayName": "Surface flow",
                        "description": "Surface flow",
                        "type": "Float",
                        "defaultValue": 0.0,
                        "min": -3.0,
                        "max": 3.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectFlow"
                        }
                    },
                    {
                        "name": "frequency",
                        "displayName": "Pattern frequency",
                        "description": "Pattern frequency",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.1,
                        "max": 6.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectFrequency"
                        }
                    },
                    {
                        "name": "erosion",
                        "displayName": "Erosion threshold",
                        "description": "Erosion threshold",
                        "type": "Float",
                        "defaultValue": 0.38,
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectErosion"
                        }
                    },
                    {
                        "name": "edge",
                        "displayName": "Rim falloff",
                        "description": "Rim falloff",
                        "type": "Float",
                        "defaultValue": 1.6,
                        "min": 0.15,
                        "max": 8.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectEdge"
                        }
                    },
                    {
                        "name": "seed",
                        "displayName": "Pattern offset",
                        "description": "Pattern offset",
                        "type": "Float",
                        "defaultValue": 0.0,
                        "min": 0.0,
                        "max": 10.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectSeed"
                        }
                    },
                    {
                        "name": "extinction",
                        "displayName": "Volume extinction",
                        "description": "Optical depth per unit distance inside the particle.",
                        "type": "Float",
                        "defaultValue": 5.0,
                        "min": 0.1,
                        "max": 16.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectExtinction"
                        }
                    },
                    {
                        "name": "coreDensity",
                        "displayName": "Interior density",
                        "description": "Minimum density in the nested core of a volume.",
                        "type": "Float",
                        "defaultValue": 0.9,
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectCoreDensity"
                        }
                    }
                ]
            }
        ]
    },
    "materialShaderCode": "MaterialGraphName_Surface.azsli",
    "materialShaderDefines": "MaterialGraphName_Defines.azsli",
    "lightingModel": "Standard",
    "functors": [
        {
            "type": "ConvertEmissiveUnit",
            "args": {
                "intensityProperty": "emissive.intensity",
                "lightUnitProperty": "emissive.unit",
                "shaderInput": "m_emissiveIntensity",
                "ev100Index": 0,
                "nitIndex": 1,
                "ev100MinMax": [
                    -10,
                    20
                ],
                "nitMinMax": [
                    0.001,
                    100000.0
                ],
                "shaderParameters": [
                    {
                        "name": "m_emissiveIntensity",
                        "type": "float"
                    }
                ]
            }
        },
        {
            "type": "Lua",
            "args": {
                "file": "Shaders/OpenParticle/Particle_EmissiveState.lua"
            }
        }
    ],
    "uvNameMap": {
        "UV0": "Tiled",
        "UV1": "Unwrapped"
    }
}
