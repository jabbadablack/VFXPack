#pragma once

#include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_MaterialInputs.azsli>
#include <OpenParticle/ParticleMeshCommon.azsli>

// LoadInstanceData / ComputeParticleWorldPosition (DrawSrg is declared in
// ParticleMeshShaderSrgs.azsli, included before this file via materialShaderDefines)
#include <OpenParticle/ParticleMeshHelpers.azsli>

// ---------------------------------------------------------------------------
float SampleParticleHeight(const MaterialParameters params, float2 uv)
{
    float3 coord = float3(uv, 1.0);
    float2 tiled = float2(dot(params.m_uvMatrixRow0.xyz, coord), dot(params.m_uvMatrixRow1.xyz, coord));
    float phase = params.m_effectSeed;
    float flow = SceneSrg::m_time * params.m_effectFlow;
    float2 p = tiled * params.m_effectFrequency + float2(phase, -phase * 0.63);
    float coarse = GetMaterialTexture(params.m_heightmap).SampleLevel(GetMaterialTextureSampler(), p + float2(0.13, -0.27) * flow, 1.5).r;
    float2 folded = float2(p.y, -p.x) * 1.83 + coarse * 0.22;
    float detail = GetMaterialTexture(params.m_heightmap).SampleLevel(GetMaterialTextureSampler(), folded + float2(-0.12, 0.16) * flow, 2.0).r;
    return saturate(0.75 * coarse + 0.25 * detail);
}

float4 ParticleLatticeHash(float4 index)
{
    float4 h = frac(index*0.1031);
    h *= h+33.33;
    return frac(h*(h+h));
}

float ParticleVolumeNoise(float3 p)
{
    float3 cell = floor(p);
    float3 f = frac(p);
    f = f*f*(3.0-2.0*f);
    float base = dot(cell,float3(1.0,157.0,113.0));
    float4 index = base + float4(0,1,157,158);
    float4 z = lerp(ParticleLatticeHash(index),ParticleLatticeHash(index+113.0),f.z);
    return lerp(lerp(z.x,z.y,f.x),lerp(z.z,z.w,f.x),f.y);
}

float3 DisplaceParticleVertex(float3 position, float3 normal, float2 uv, const MaterialParameters params, ParticleMeshInstanceData particle)
{
    #define O3DE_MC_UV(index) uv
    // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inRelief
uint node1_uv_inIndex = 0;
float2 node1_uv_outUV = O3DE_MC_UV(node1_uv_inIndex);
float2 node2_particle_height_field_inUV = node1_uv_outUV;
float node2_particle_height_field_outHeight = SampleParticleHeight(params, node2_particle_height_field_inUV);
float inRelief = node2_particle_height_field_outHeight;
    // O3DE_GENERATED_INSTRUCTIONS_END
    #undef O3DE_MC_UV
    if (params.m_effectStyle > 30.5)
    {
        // The covering mesh keeps its source pivot and vertex positions.
        // Offset along its own smooth normals so even narrow limbs stay separate.
        float width = params.m_heightmapScale;
        if (params.m_effectStyle > 37.5 && params.m_effectStyle < 44.5)
        {
            float drift = SceneSrg::m_time * params.m_effectFlow;
            float vapor = ParticleVolumeNoise(position*2.7 + float3(params.m_effectSeed,0.0,-drift*0.4));
            // Lift the outer volume above the skin. The density fades to zero at this boundary.
            float3 outward = normalize(normal);
            float lift = width*(.40 + 1.70*vapor);
            return position + outward*width*(.67+.59*vapor)
                   + float3(.18*lift*sin(drift+position.z*3.1),.16*lift*cos(drift*.8+position.z*2.6),lift);
        }
        return position + normalize(normal) * width;
    }
    // The unit sphere bounds the integration. Its surface never contributes light.
    if (params.m_effectStyle > 10.5 || abs(params.m_effectStyle-8.0) < 0.5) return position;
    return position + normal * ((inRelief - 0.5 + params.m_heightmapOffset) * params.m_heightmapScale);
}

float3 RotateParticleDirection(float3 v, ParticleMeshInstanceData data)
{
    float3 initial = mul(AxisRadianToMatrix(data.m_initRotation), v);
    // SimuCore's CPU mesh stream stores the spin axis in xyz and accumulated radians in w.
    float4 spin = data.m_rotationQuat;
    return dot(spin.xyz, spin.xyz) > 0.000001 ? mul(AxisRadianToMatrix(spin), initial) : initial;
}

float3 ParticleSurfaceWorldPosition(float3 localPosition, ParticleMeshInstanceData data, float4x4 objectToWorld)
{
    float3 rotated = RotateParticleDirection(localPosition * data.m_scale.xyz, data);
    return mul(objectToWorld, float4(rotated, 1.0)).xyz + data.m_offset.xyz;
}

// Per-pipeline-stage vertex / pixel shader implementations
// ---------------------------------------------------------------------------

#if MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE || MATERIALPIPELINE_SHADER_HAS_GEOMETRIC_PIXEL_STAGE
    #define EvaluateVertexGeometry EvaluateVertexGeometry_ParticleMesh

    VsOutput EvaluateVertexGeometry_ParticleMesh(VsInput IN, VsSystemValues SV, const MaterialParameters params)
    {
        ParticleMeshInstanceData instanceData = LoadInstanceData(SV.m_instanceId);
        float4x4 objectToWorld = GetObjectToWorldMatrix(SV);
        float3 displaced = DisplaceParticleVertex(IN.position, IN.normal, IN.uv0, params, instanceData);
        float3 worldPosition = ParticleSurfaceWorldPosition(displaced, instanceData, objectToWorld);

        VsOutput OUT;
        OUT.position = mul(GetViewProjectionMatrix(SV), float4(worldPosition, 1.0));

#if MATERIAL_USES_VERTEX_LOCALPOSITION
        OUT.localPosition = (params.m_effectStyle > 37.5 && params.m_effectStyle < 44.5) ? displaced : IN.position;
#endif

#if MATERIAL_USES_VERTEX_POSITIONWS
        OUT.worldPosition = worldPosition;
#endif

#if MATERIAL_USES_VERTEX_UV
        float3 uv0h = float3(IN.uv0, 1.0);
        OUT.uvs[0] = float2(dot(params.m_uvMatrixRow0.xyz, uv0h), dot(params.m_uvMatrixRow1.xyz, uv0h));
        OUT.uvs[1] = params.m_effectStyle > 10.5 && params.m_effectStyle < 30.5
            ? float2(saturate(IN.position.z + 0.5), instanceData.m_initRotation.w + dot(instanceData.m_scale.xyz, float3(0.83, 2.76, 1.78)))
            : IN.uv1;
#endif

#if MATERIAL_USES_VERTEX_NORMAL
        OUT.normal = normalize(RotateParticleDirection(IN.normal / max(abs(instanceData.m_scale.xyz), 0.0001), instanceData));
        if (params.m_effectStyle > 37.5)
            OUT.normal = normalize(mul((float3x3)objectToWorld,OUT.normal));
#endif
#if MATERIAL_USES_VERTEX_TANGENT
        OUT.tangent = float4(normalize(RotateParticleDirection(IN.tangent.xyz * instanceData.m_scale.xyz, instanceData)), IN.tangent.w);
#endif
#if MATERIAL_USES_VERTEX_BITANGENT
        OUT.bitangent = IN.bitangent;
#endif

#if MATERIAL_USES_VERTEX_COLOR
        OUT.color0 = instanceData.m_color;
        // Blue carries normalized age on the graph-driven pack meshes.
        OUT.color0.b = instanceData.m_hasInstanceData.x == 0 ? 0.3 : instanceData.m_color.b;
#endif

#if MATERIAL_USES_VERTEX_TANGENT && MATERIAL_USES_VERTEX_LOCALPOSITION
        if ((params.m_effectStyle > 10.5 && params.m_effectStyle < 30.5) ||
            (params.m_effectStyle > 37.5 && params.m_effectStyle < 44.5))
        {
            // Carry the ray in the ellipsoid's local coordinates, including nonuniform scale.
            float3 ray = worldPosition - ViewSrg::m_worldPosition.xyz;
            float3 bx = mul((float3x3)objectToWorld, RotateParticleDirection(float3(instanceData.m_scale.x, 0, 0), instanceData));
            float3 by = mul((float3x3)objectToWorld, RotateParticleDirection(float3(0, instanceData.m_scale.y, 0), instanceData));
            float3 bz = mul((float3x3)objectToWorld, RotateParticleDirection(float3(0, 0, instanceData.m_scale.z), instanceData));
#if MATERIAL_USES_VERTEX_NORMAL
            if ((params.m_effectStyle > 15.5 && params.m_effectStyle < 16.5) || (params.m_effectStyle > 17.5 && params.m_effectStyle < 30.5))
            {
                float3 key = normalize(float3(-0.35,-0.48,0.80));
                if (SceneSrg::m_directionalLightCount > 0) key = -normalize(SceneSrg::m_directionalLights[0].m_direction);
                OUT.normal = normalize(float3(dot(key,bx)/max(dot(bx,bx),0.000001),dot(key,by)/max(dot(by,by),0.000001),dot(key,bz)/max(dot(bz,bz),0.000001)));
            }
#endif
            OUT.tangent = float4(dot(ray, bx) / max(dot(bx,bx), 0.000001),
                                 dot(ray, by) / max(dot(by,by), 0.000001),
                                 dot(ray, bz) / max(dot(bz,bz), 0.000001), 1.0);
        }
#endif
        OUT.m_instanceId = SV.m_instanceId;
        return OUT;
    }
#endif

#if MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE

    COMMON_OPTIONS_BASE_COLOR()
    COMMON_OPTIONS_VERTEX_COLOR()
    COMMON_OPTIONS_ROUGHNESS()
    COMMON_OPTIONS_METALLIC()
    COMMON_OPTIONS_SPECULAR_F0()
    COMMON_OPTIONS_NORMAL()
    COMMON_OPTIONS_CLEAR_COAT()
    COMMON_OPTIONS_OCCLUSION()
    COMMON_OPTIONS_EMISSIVE()
    COMMON_OPTIONS_PARALLAX()

    bool ShouldHandleParallax()   { return false; }
    bool NeedsTangentFrame()      { return o_normal_useTexture || (o_clearCoat_enabled && o_clearCoat_normal_useTexture); }

    DepthResult GetDepth(const MaterialParameters params, Texture2D heightmap, sampler mapSampler, float2 uv, float2 uv_ddx, float2 uv_ddy)
    {
        return SampleDepthFromHeightmap(heightmap, mapSampler, uv, uv_ddx, uv_ddy);
    }

    #include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_PixelGeometryEval.azsli>
    #define EvaluateSurface EvaluateParticleSurface
    #include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_SurfaceEval.azsli>
    Surface EvaluateParticleSurface(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData, const MaterialParameters params)
    {
        Surface surface = EvaluateSurface_StandardPBR(IN, SV, geoData, params);
        // IN.uvs already contains the material UV transform. Use the original UV
        // for the shared graph to avoid tiling the surface field twice.
        float3 uvh = float3(IN.uvs[0], 1.0);
        float2 uv = float2(dot(params.m_uvMatrixInverseRow0.xyz, uvh), dot(params.m_uvMatrixInverseRow1.xyz, uvh));
        #define O3DE_MC_UV(index) uv
        // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inEmissionMask, inRoughnessMask, inCoverage, inRim, inBulkDensity, inOpticalDepth
uint node1_uv_inIndex = 0;
float2 node1_uv_outUV = O3DE_MC_UV(node1_uv_inIndex);
float2 node2_particle_height_field_inUV = node1_uv_outUV;
float node2_particle_height_field_outHeight = SampleParticleHeight(params, node2_particle_height_field_inUV);
float node3_multiply_inValue1 = node2_particle_height_field_outHeight;
float node3_multiply_inValue2 = node2_particle_height_field_outHeight;
float node3_multiply_outValue = node3_multiply_inValue1 * node3_multiply_inValue2;
float node4_saturate_inValue = node2_particle_height_field_outHeight;
float node4_saturate_outValue = saturate(node4_saturate_inValue);
float node6_erosion_and_fresnel_inDensity = node2_particle_height_field_outHeight;
float node6_erosion_and_fresnel_outCoverage = smoothstep(-0.09, 0.09, node6_erosion_and_fresnel_inDensity - params.m_effectErosion - 0.42 * smoothstep(0.42, 1.0, IN.color0.b));
float node6_erosion_and_fresnel_outRim = pow(saturate(1.0 - abs(dot(normalize(ViewSrg::m_worldPosition.xyz - geoData.positionWS), surface.normal))), params.m_effectEdge);
float inEmissionMask = node3_multiply_outValue;
float inRoughnessMask = node4_saturate_outValue;
float inCoverage = node6_erosion_and_fresnel_outCoverage;
float inRim = node6_erosion_and_fresnel_outRim;
float node7_participating_medium_inDensityScale = 1.0;
float node7_participating_medium_outCore = saturate(params.m_effectCoreDensity * node7_participating_medium_inDensityScale);
float node7_participating_medium_inExtinctionScale = 1.0;
float node7_participating_medium_outExtinction = max(0.01, params.m_effectExtinction * node7_participating_medium_inExtinctionScale);
float inBulkDensity = node7_participating_medium_outCore;
float inOpticalDepth = node7_participating_medium_outExtinction;
        // O3DE_GENERATED_INSTRUCTIONS_END
        #undef O3DE_MC_UV
        float style = params.m_effectStyle;
        float age = saturate(IN.color0.b);
        float field = saturate(inRoughnessMask);
        float ridges = saturate(inEmissionMask);
        float rim = saturate(inRim);
        float coverage = saturate(inCoverage);
        float fade = saturate(IN.color0.a);
        float3 tint = max(params.m_emissiveColor.rgb, float3(0.015, 0.015, 0.015));
        float glow = max(0.0, params.m_emissiveIntensity);
        if (style > 0.5 && style < 1.5)
        {
            // Raised pockets stay incandescent as an outer skin of clinker breaks apart.
            float seam = 1.0 - smoothstep(0.018, 0.115, abs(field - 0.48));
            float cooling = smoothstep(0.14, 0.82, age);
            float mantle = smoothstep(0.24 + 0.37 * cooling, 0.44 + 0.40 * cooling, field);
            float heat = saturate((1.0 - cooling) * 0.64 + mantle * 0.55 + seam * (0.18 + 0.72 * cooling));
            float3 coal = tint * float3(0.18, 0.055, 0.025);
            float3 hot = lerp(tint * float3(1.15, 0.52, 0.17), float3(1.0, 0.87, 0.55), smoothstep(0.41, 0.83, heat));
            surface.albedo = lerp(coal, tint * 0.50, field);
            surface.emissiveLighting = hot * glow * (0.016 + 2.1 * heat * heat) * lerp(1.25, 0.48, cooling);
            surface.alpha *= lerp(0.91, coverage, smoothstep(0.30, 0.95, age));
        }
        else if (style > 1.5 && style < 2.5)
        {
            // Dense billows have lit shoulders and a soft, progressively porous edge.
            float shoulder = saturate(0.5 + 0.5 * surface.normal.z);
            surface.albedo = params.m_baseColor.rgb * lerp(0.36, 1.18, shoulder * 0.62 + field * 0.38);
            float lightBand = smoothstep(0.22, 0.62, shoulder * 0.76 + field * 0.24);
            surface.emissiveLighting = tint * glow * (0.11 + 0.47 * lightBand);
            surface.albedo *= lerp(0.66, 1.14, lightBand);
            float facing = saturate(1.0 - rim);
            float silhouette = smoothstep(0.08, 0.49, facing + (field - 0.52) * 1.34);
            float porous = smoothstep(0.15 + 0.27 * age, 0.47 + 0.25 * age, field + facing * 0.16);
            surface.alpha *= silhouette * porous * lerp(0.91, 0.58, age);
        }
        else if (style > 2.5 && style < 3.5)
        {
            // A narrow vein interrupts the broad planar highlights on cut faces.
            float vein = 1.0 - smoothstep(0.012, 0.052, abs(field - 0.51));
            surface.emissiveLighting = tint * glow * (0.045 + rim * 0.77 + vein * 0.92);
            surface.alpha *= lerp(0.64, 1.0, saturate(rim + 0.4 * field));
        }
        else if (style > 3.5 && style < 4.5)
        {
            float meniscus = pow(rim, 1.55);
            float film = smoothstep(0.51, 0.69, field);
            surface.albedo *= lerp(0.45, 1.18, film);
            surface.emissiveLighting = tint * glow * (0.06 + 0.42 * film + 1.15 * meniscus);
            surface.alpha *= lerp(0.27, 0.98, saturate(meniscus + 0.45 * film));
        }
        else if (style > 4.5 && style < 5.5)
        {
            float crest = smoothstep(0.37, 0.78, field);
            float core = saturate(crest * 0.76 + (1.0 - rim) * 0.38);
            surface.emissiveLighting = lerp(tint, lerp(tint, float3(1.0, 1.0, 1.0), 0.69), core * core) * glow * (0.38 + 1.35 * core);
            surface.alpha *= lerp(0.42, 1.0, coverage);
        }
        else if (style > 5.5 && style < 6.5)
        {
            float band = 1.0 - smoothstep(0.025, 0.12, abs(field - 0.54));
            surface.emissiveLighting = tint * glow * (0.045 + 0.63 * band + 1.25 * rim);
            surface.alpha *= saturate(0.09 + 0.53 * band + 0.75 * rim) * lerp(0.3, 1.0, coverage);
        }
        else if (style > 6.5 && style < 7.5)
        {
            float crack = smoothstep(0.57, 0.84, field);
            surface.albedo *= lerp(0.40, 0.89, field);
            surface.emissiveLighting = tint * glow * (0.012 + crack * crack * 0.82);
        }
        else if (style > 7.5 && style < 8.5)
        {
            // UV.y runs from source to impact. UV.x wraps the low-poly sleeve.
            float along = saturate(uv.y);
            float phase = 6.283185 * (uv.x * 2.0 + along * 1.72 - SceneSrg::m_time * params.m_effectFlow + field * 0.23);
            float strand = smoothstep(0.34, 0.88, cos(phase));
            // Preserve the circular face and cylindrical silhouette through both ends.
            float core = pow(saturate(1.0 - rim), 2.6);
            surface.alpha = params.m_opacityFactor * saturate(0.54 + core * 0.36 + strand * 0.24);
            surface.emissiveLighting = lerp(tint * 0.56, lerp(tint, float3(1.0, 1.0, 1.0), 0.86), core * core) * glow * (0.40 + 1.30 * core + 0.47 * strand);
        }
        else if (style > 8.5 && style < 9.5)
        {
            float height = saturate(uv.y);
            float flameField = field + 0.21 * sin(6.283185 * (uv.x * 2.0 - height * 1.4 + SceneSrg::m_time * params.m_effectFlow));
            float body = smoothstep(0.03, 0.21, flameField + 0.41 - height * 0.81 - age * 0.18);
            float hearth = (1.0 - smoothstep(0.10, 0.67, height)) * smoothstep(0.25, 0.64, field);
            float3 orange = lerp(tint * float3(0.74, 0.23, 0.08), tint, saturate(field + 0.23 - height * 0.46));
            surface.emissiveLighting = lerp(orange, float3(1.0, 0.70, 0.25), hearth) * glow * (0.21 + 0.81 * hearth + 0.22 * field);
            surface.alpha *= body * (1.0 - smoothstep(0.74, 1.0, age) * 0.88);
        }
        else if (style > 9.5 && style < 10.5)
        {
            // A spherical shell has a clear window around its view-facing pole.
            float3 viewDirection = normalize(ViewSrg::m_worldPosition.xyz - geoData.positionWS);
            float grazing = 1.0 - saturate(abs(dot(viewDirection, normalize(surface.normal))));
            float rimBand = smoothstep(0.28, 0.85, grazing);
            clip(rimBand - 0.001);
            float crest = pow(grazing, 3.1);
            float glint = smoothstep(0.38, 0.67, field) * crest;
            surface.albedo = tint * 0.20;
            surface.alpha = params.m_opacityFactor * rimBand * lerp(0.38, 0.98, crest);
            surface.emissiveLighting = lerp(tint, float3(0.96, 0.99, 1.0), glint * 0.75) * glow * rimBand * (0.16 + 0.94 * crest);
            surface.roughnessLinear = lerp(0.16, 0.045, glint);
        }
        else if (style > 37.5)
        {
#if MATERIAL_USES_VERTEX_LOCALPOSITION
            float3 p = IN.localPosition;
#else
            float3 p = geoData.positionWS;
#endif
            float3 eyeDirection = normalize(ViewSrg::m_worldPosition.xyz - geoData.positionWS);
#if MATERIAL_USES_VERTEX_NORMAL
            float mu = saturate(abs(dot(normalize(IN.normal),eyeDirection)));
#else
            float mu = saturate(abs(dot(normalize(cross(ddy(geoData.positionWS),ddx(geoData.positionWS))),eyeDirection)));
#endif
            float t = SceneSrg::m_time * params.m_effectFlow;
            surface.albedo = float3(0,0,0);
            surface.specularF0 = float3(0,0,0);
            if (style > 44.5)
            {
                // A stepped leader advances through the authored fork once. Both return
                // strokes illuminate those exact branches before the ionized air cools.
                float along = saturate(p.z + 0.5);
                float travelled = saturate(age*7.8);
                float leader = smoothstep(along-.085,along+.025,travelled)*(1.0-smoothstep(.12,.20,age));
                float firstStroke = exp(-15.0*max(0.0,age-.18))*smoothstep(.14,.18,age);
                float secondStroke = .80*exp(-20.0*max(0.0,age-.54))*smoothstep(.50,.54,age);
                float pulse = .19*leader + firstStroke + secondStroke;
                float coreLight = smoothstep(.68,.99,mu);
                surface.alpha = params.m_opacityFactor*smoothstep(.035,.57,mu)*saturate(pulse*2.8);
                surface.emissiveLighting = lerp(tint,float3(.86,.95,1.),coreLight) * glow * (.32+1.9*coreLight)*pulse;
            }
            else
            {
                // Integrate a short view ray through the translucent gas outside the host.
                // A curved local skin limits the path on the chest and around narrow limbs.
                float phase = params.m_effectSeed;
                float width = max(.015,params.m_heightmapScale);
#if MATERIAL_USES_VERTEX_TANGENT && MATERIAL_USES_VERTEX_LOCALPOSITION
                float3 rayDirection = normalize(IN.tangent.xyz);
#else
                float3 rayDirection = -eyeDirection;
#endif
                float radius = width*2.8;
#if MATERIAL_USES_VERTEX_NORMAL
                float curvature = (length(ddx(IN.normal))+length(ddy(IN.normal))) /
                                   max(.0001,length(ddx(p))+length(ddy(p)));
                radius = clamp(1.0/max(.10,curvature),width*1.5,width*4.5);
#endif
                float ratio = width/radius;
                float travel = radius*(mu-sqrt(max(0.0,mu*mu-ratio*(2.0-ratio))));
                float accumulated = 0.0;
                float vaporTone = 0.0;
                for (int stepIndex=0; stepIndex<5; ++stepIndex)
                {
                    float d = travel*(float(stepIndex)+.5)/5.0;
                    float inset = (radius-sqrt(max(.00001,radius*radius-2.0*radius*mu*d+d*d)))/width;
                    float3 samplePos = p + d*rayDirection;
                    float3 q = samplePos*params.m_effectFrequency*float3(3.2,3.2,1.32);
                    q.z -= SceneSrg::m_time*(.32+saturate(params.m_effectFlow)*.67);
                    q.xy += float2(.40*sin(1.54*q.z-.36*t+phase),.37*cos(1.78*q.z+.24*t-phase));
                    q += float3(phase,.63*phase,.24*phase);
                    float broad = ParticleVolumeNoise(q);
                    float fine = ParticleVolumeNoise(q*1.91+float3(.47*broad,-.59*broad,.31*broad));
                    float sheet = 1.0-smoothstep(.022,.175,abs(.64*broad+.36*fine-.50));
                    float gathering = smoothstep(.20,.74,broad+.15*(fine-.5));
                    float density = (.045 + 1.65*sheet*sheet*gathering)*smoothstep(.01,.70,inset);
                    accumulated += density;
                    vaporTone += density*fine;
                }
                float opticalDepth = accumulated*travel*(3.80/5.0);
                surface.alpha = params.m_opacityFactor*(1.0-exp(-opticalDepth));
                float tone = vaporTone/max(.001,accumulated);
                float3 auraTint = lerp(tint,lerp(tint,float3(.90,.94,1.0),.29),smoothstep(.24,.76,tone));
                if (style > 39.5 && style < 40.5)
                    auraTint = lerp(tint,float3(1.0,.48,.07),smoothstep(.28,.72,tone)*.65);
                else if (style > 43.5)
                    auraTint = lerp(tint,float3(.54,.33,.91),smoothstep(.30,.75,tone)*.64);
                surface.emissiveLighting = auraTint*glow*(.76+.47*tone);
                if (style > 38.5 && style < 39.5)
                {
                    // A surface channel retains its route during its leader and both return
                    // strokes. Piecewise-linear noise gives each discharge angular bends.
                    float cycle = SceneSrg::m_time*3.1 + phase;
                    float burstId = floor(cycle);
                    float fraction = frac(cycle);
                    float seed = ParticleLatticeHash(71.0*burstId+19.0).x;
                    float azimuth = seed*6.283185;
                    float u = dot(p.xy,float2(cos(azimuth),sin(azimuth)));
                    float axisPos = p.z + .37*dot(p.xy,float2(-sin(azimuth),cos(azimuth)));
                    float q = axisPos*10.0 + 37.0*burstId;
                    float idx = floor(q);
                    float4 bends = ParticleLatticeHash(float4(idx,idx+1.0,floor(q*3.0),floor(q*3.0)+1.0));
                    float kink = lerp(bends.x,bends.y,frac(q))-.5;
                    float jag = lerp(bends.z,bends.w,frac(q*3.0))-.5;
                    float route = .23*(seed-.5)+.12*sin(axisPos*4.3+azimuth)+.19*kink+.045*jag;
                    float lateral = frac((u-route)/.94+.5)*.94-.47;
                    float z = frac((axisPos+.89*seed)/1.60);
                    float split = saturate((z-.42)/.37);
                    float side = abs(lateral-(.24+.05*kink)*split);
                    float branchDist = lerp(1.0,side,smoothstep(.42,.44,z)*(1.0-smoothstep(.72,.80,z)));
                    float channelDist = min(abs(lateral),branchDist);
                    float aa = clamp(fwidth(lateral)*.55,.001,.012);
                    float filament = 1.0-smoothstep(.002,.006+aa,channelDist);
                    float halo = exp(-channelDist*56.0);
                    float head = smoothstep(z-.045,z+.016,saturate(fraction*7.8));
                    float power = .14*head + 1.1*exp(-28.0*max(0.0,fraction-.15))*smoothstep(.12,.15,fraction)
                                  + .76*exp(-26.0*max(0.0,fraction-.42))*smoothstep(.39,.42,fraction);
                    power *= smoothstep(.03,.14,z)*(1.0-smoothstep(.76,.96,z))*(1.0-smoothstep(.58,.82,fraction));
                    surface.alpha = saturate(surface.alpha + power*(.21*halo+.63*filament));
                    surface.emissiveLighting += power*(float3(.16,.42,1.)*halo*2.1 + float3(.78,.90,1.)*filament*6.0);
                }
            }
            surface.roughnessLinear = .96;
        }
        else if (style > 30.5)
        {
#if MATERIAL_USES_VERTEX_LOCALPOSITION
            float3 pos = IN.localPosition;
#else
            float3 pos = geoData.positionWS;
#endif
            float t = SceneSrg::m_time * params.m_effectFlow;
            float phase = params.m_effectSeed;
            float3 coord = pos * params.m_effectFrequency;
            float3 view = normalize(ViewSrg::m_worldPosition.xyz - geoData.positionWS);
            float3 geomNormal = normalize(cross(ddy(geoData.positionWS),ddx(geoData.positionWS)));
            float edge = pow(1.0-saturate(abs(dot(geomNormal,view))),1.25);
            float n = ParticleVolumeNoise(coord*1.75+float3(phase,0.13*t,-0.19*t));
            float tracks;
            if (style < 31.5) // Intersecting metallic lines.
                tracks = min(abs(sin(8.1*coord.z + 3.4*coord.x-t)),abs(sin(7.0*coord.x-4.2*coord.z+0.47*t)));
            else if (style < 32.5) // Longitudinal silk.
                tracks = abs(sin(13.5*coord.x + 4.2*sin(2.6*coord.z-.7*t)+3.0*coord.y));
            else if (style < 33.5) // Fracture veins.
                tracks = abs(sin(8.2*n + 2.3*coord.z - .55*t));
            else if (style < 34.5) // Folded plasma.
                tracks = abs(sin(6.2*coord.z + 2.8*sin(3.5*coord.x+3.1*n-t)+3.1*n));
            else if (style < 35.5) // A sweeping horizontal pulse.
                tracks = abs(sin(8.0*coord.z-2.2*t + 1.25*n));
            else if (style < 36.5) // Organic branching paths.
                tracks = min(abs(sin(7.5*n+4.0*coord.x+.3*t)),abs(sin(11.0*n-3.3*coord.y-.4*t)));
            else // Interlocking diagonals wrap across the surface.
                tracks = min(abs(sin(7.8*coord.z+5.0*coord.x+.34*t)),abs(sin(7.8*coord.z-5.0*coord.x-.34*t)));
            float traceBand = 1.0-smoothstep(.055,.24+min(.18,fwidth(tracks)),tracks);
            float sweep = smoothstep(.70,.99,cos(5.1*coord.z-1.8*t+phase+1.5*n));
            surface.alpha = params.m_opacityFactor * saturate(.16+.76*edge+.29*traceBand+.17*sweep);
            surface.albedo = float3(0,0,0);
            surface.specularF0 = float3(0,0,0);
            surface.roughnessLinear = .91;
            float3 crest = lerp(tint, float3(1.0,.98,.94),.23*edge+.13*sweep);
            surface.emissiveLighting = crest*glow*(.67+1.6*edge+.75*traceBand+.38*sweep);
        }
        else if (style > 10.5)
        {
            float phase = params.m_effectSeed + IN.uvs[1].y;
            float clock = SceneSrg::m_time * params.m_effectFlow;
            bool flame = style > 11.5 && style < 12.5;
            bool wave = style > 12.5 && style < 13.5;
            bool cap = style > 13.5 && style < 14.5;
            bool plume = style > 14.5 && style < 15.5;
            bool radialFront = style > 16.5 && style < 18.5;
            bool porousFire = style > 18.5 && style < 21.5;
            bool smokeShape = style > 21.5;
            flame = flame || (style > 19.5 && style < 20.5);
            plume = plume || (style > 20.5 && style < 21.5);
            bool cloud = (style > 15.5 && style < 16.5) || (style > 17.5 && style < 18.5) || smokeShape;
#if MATERIAL_USES_VERTEX_TANGENT && MATERIAL_USES_VERTEX_LOCALPOSITION
            float3 entry = 2.0 * IN.localPosition;
            float3 toSurface = IN.tangent.xyz * 2.0;
            float3 ray = normalize(toSurface);
            float3 eye = entry - toSurface;
#else
            float3 entry = normalize(surface.normal);
            float3 ray = normalize(geoData.positionWS - ViewSrg::m_worldPosition.xyz);
            float3 eye = entry - 10.0 * ray;
#endif
            float projected = dot(entry,ray);
            float cameraProjection = dot(eye,ray);
            float halfChord = sqrt(max(0.0,cameraProjection*cameraProjection + 1.0 - dot(eye,eye)));
            float nearT = max(0.0,-cameraProjection - halfChord);
            float farT = max(nearT,-cameraProjection + halfChord);
            float cameraToHull = max(0.00001,length(entry-eye));
            float3 cameraWS = ViewSrg::m_worldPosition.xyz;
            float3 nearWS = cameraWS + (geoData.positionWS-cameraWS)*(nearT/cameraToHull);
            float4 nearClip = mul(ViewSrg::m_viewProjectionMatrix,float4(nearWS,1.0));
            // Switch to the exit face when the camera or its near plane intersects the medium.
            // The integration limits are the same on either face.
            bool fromExit = nearT < 0.0001 || nearClip.w <= 0 || nearClip.z >= nearClip.w || nearClip.z < 0;
            if (fromExit ? projected <= 0.0 : projected >= 0.0) discard;
            float chord = farT-nearT;
            entry = eye+ray*nearT;
            // Integrate the full path even for distant puffs. Spend the extra samples
            // on volumes which cover enough pixels to resolve the smaller eddies.
#if MATERIAL_USES_VERTEX_LOCALPOSITION
            float pixelFootprint = max(length(ddx(IN.localPosition)),length(ddy(IN.localPosition)));
            float projectedPixels = 1.0/max(0.001,pixelFootprint);
#else
            float projectedPixels = 120.0;
#endif
            float detailWeight = smoothstep(26.0,90.0,projectedPixels);
            int steps = projectedPixels < 35.0 ? 3 : (projectedPixels < 86.0 ? 5 : ((plume || cap || cloud) ? 9 : 7));
            float stepLength = chord / float(steps);
            float transmittance = 1.0;
            float3 light = float3(0, 0, 0);
            for (int i = 0; i < steps; ++i)
            {
                float3 pos = entry + ray * ((float(i) + 0.5) * stepLength);
                float h = saturate(0.5 + 0.5 * pos.z);
                float2 bend = float2(sin(7.0*h - 2.27*clock + phase), cos(8.6*h - 2.03*clock + phase));
                float2 offset = (plume ? 0.32 : 0.11) * h * h * bend;
                float2 lateral = radialFront ? pos.xy : pos.xy - offset;
                float radial = length(lateral);
                float theta = atan2(lateral.y, lateral.x);
                float3 q = float3(lateral, pos.z);
                if (cap)
                {
                    // Roll the outer layer over the rising head of the thermal.
                    float2 section = float2(radial - 0.48, pos.z - 0.06);
                    float angle = 1.32 + 3.12*age + 2.32*exp(-5.4*dot(section,section));
                    float2 axis = float2(cos(angle),sin(angle));
                    float2 turned = float2(dot(section,float2(axis.x,-axis.y)),dot(section,axis.yx));
                    q = float3(lateral * ((turned.x + 0.48) / max(radial,0.035)), turned.y + 0.10*sin(4.0*theta + phase));
                }
                // Advect after shaping the local domain. Phase and clock translate sampling
                // coordinates only, so neither elapsed scene time nor world origin can stretch the field.
                float3 drift = (plume || flame) ? float3(0.06,0.11,-1.02) : float3(0.08,-0.14,-0.42);
                float3 coord = q * (1.12 + 0.72 * params.m_effectFrequency);
                coord += float3(1.7, 0.71, 1.29) * phase + drift * clock;
                if (porousFire)
                {
                    coord.xy += 0.40 * float2(sin(pos.z*4.6-clock*1.9+phase),cos(pos.z*3.8-clock*1.4-phase));
                    coord.z *= 0.72;
                }
                float broad = ParticleVolumeNoise(coord);
                float detail = broad;
                if (detailWeight > 0.001) detail = lerp(broad,ParticleVolumeNoise(coord*1.96 + float3(0.52,-0.43,0.39)*broad),detailWeight);
                float noise = saturate(0.73*broad + 0.27*detail);
                float r = length(pos);
                float reach = 0.80 + 0.57*(noise - 0.50);
                float profile = reach - r;
                float core = 1.0-smoothstep(0.32,0.70,r);
                if (plume || flame)
                {
                    float width = plume ? lerp(0.81,0.075,pow(h,0.87)) : lerp(0.79,0.40,h);
                    float lobes = 0.072*sin(3.0*theta + 6.5*h - 1.8*clock + phase);
                    profile = min(width + lobes + 0.70*(noise-0.50) - radial, min(h-0.025,0.995-h)*2.7);
                    core = (1.0-smoothstep(width*0.33,width*0.86,radial)) * smoothstep(0.025,0.12,h)*(1.0-smoothstep(0.72,0.97,h));
                }
                if (cloud || cap || wave)
                {
                    float3 wrinkled = pos + 0.12*float3(sin(4.5*pos.y+phase+age),cos(3.9*pos.z-phase+age),sin(4.1*pos.x+phase))*(0.42+noise);
                    float coreLobe = 0.72-length(wrinkled*float3(0.97,1.03,1.11));
                    float leftLobe = 0.49-length(wrinkled-float3(-0.32,0.18,0.26));
                    float rightLobe = 0.48-length(wrinkled-float3(0.35,-0.16,0.11));
                    profile = max(coreLobe,max(leftLobe,rightLobe)) + 0.72*(noise-0.50);
                }
                float frontFold = 0.55;
                if (radialFront)
                {
                    // The crest has a filled elliptical cross-section in the radial/height plane
                    // at every azimuth. Curvature and rotating folds perturb it without opening gaps.
                    float angle = atan2(pos.y,pos.x);
                    float winding = 8.0*angle + 1.19*sin(3.0*angle+phase) + phase + 1.14*age;
                    float lobe = 0.5+0.5*cos(winding);
                    float crestRipple = 0.72*sin(5.0*angle+phase+age) + 0.28*cos(11.0*angle-0.71*phase);
                    float radius = lerp(0.35,0.68,smoothstep(0.0,0.69,age)) + 0.060*crestRipple;
                    float crestZ = -0.075 + 0.25*lobe + 0.075*crestRipple + 0.10*age;
                    float2 section = float2((radial-radius)/(0.25 + 0.082*lobe + 0.035*noise),
                                            (pos.z-crestZ)/(0.43+0.22*lobe+0.07*noise));
                    float sectionRadius = length(section);
                    float roll = 0.5+0.5*sin(atan2(section.y,section.x) + 5.5*age + 3.1*noise + 0.34*crestRipple);
                    profile = (1.0-sectionRadius)*0.56 + 0.14*(noise-0.5);
                    core = 1.0-smoothstep(0.40,0.83,sectionRadius);
                    // Gas behind the crest couples it to the erupting center while the front expands.
                    float wake = (1.0-smoothstep(radius-0.10,radius+0.08,radial)) *
                                 (1.0-smoothstep(0.11,0.57,abs(pos.z+0.14))) * (1.0-0.67*age);
                    core = max(core,0.48*wake);
                    float circulation = atan2(section.y,section.x) + 5.4*age;
                    float foldPattern = cos(2.0*circulation + 1.75*sin(winding) + 5.8*(noise-0.5));
                    frontFold = saturate(0.46+0.37*foldPattern+0.28*(lobe-0.5)+0.42*(noise-0.5));
                    noise = 0.52*noise + 0.28*roll + 0.20*lobe;
                }
                float density = max(inBulkDensity*core, smoothstep(-0.12,0.20,profile)*lerp(0.49,1.18,noise));
                density *= 1.0-smoothstep(0.79,0.985,r);
                if (porousFire)
                {
                    // Two winding flame fronts leave intermittently transparent pockets between them.
                    float fold = cos(2.0*theta + 5.1*h - 2.3*clock + phase + 5.0*(noise-0.5));
                    float fuel = 1.20*(noise-0.47) + 0.24*fold + 0.18*(1.0-h);
                    float sheet = smoothstep(-0.09,0.30,fuel);
                    density *= (0.055+0.945*sheet)*(0.45+0.55*smoothstep(-0.17,0.28,profile));
                    core *= sheet;
                }
                if (smokeShape)
                {
                    float envelope = 1.0-smoothstep(0.54,1.0,r);
                    float billows = smoothstep(0.22,0.70,noise);
                    float filament = 1.0-smoothstep(0.04,0.25,abs(noise-0.52));
                    float shape;
                    if (style < 22.5) shape = (0.25+billows)*envelope; // flaring anvil
                    else if (style < 23.5) shape = filament*smoothstep(-0.24,0.38,noise+0.40*sin(pos.z*4.0+phase)-0.30)*envelope;
                    else if (style < 24.5) shape = (0.15+0.95*billows)*(0.48+0.52*cos(5.2*pos.z+3.1*noise))*envelope;
                    else if (style < 25.5) shape = smoothstep(0.36,0.64,noise+0.12*sin(pos.z*6.0+phase))*envelope;
                    else if (style < 26.5) shape = (0.25+0.85*billows)*smoothstep(-0.3,0.4,0.4-pos.z+0.27*noise)*envelope;
                    else if (style < 27.5) shape = smoothstep(0.39,0.68,detail)*billows*1.7*envelope;
                    else if (style < 28.5) shape = (0.12+billows*billows*1.25)*envelope;
                    else if (style < 29.5) shape = filament*filament*(0.52+0.48*cos(3.6*pos.y+6.3*noise))*envelope;
                    else shape = smoothstep(0.23,0.72,noise)*envelope;
                    density = shape * (0.70+0.55*inBulkDensity);
                }
                float deltaOpacity = 1.0-exp(-density*stepLength*inOpticalDepth);
                float3 radiance;
                if (cloud)
                {
                    // A short light path through the same cloud yields bright shoulders and a shaded interior.
#if MATERIAL_USES_VERTEX_NORMAL
                    float3 towardsLight = normalize(IN.normal);
#else
                    float3 towardsLight = normalize(float3(-0.35,-0.48,0.80));
#endif
                    float along = dot(pos,towardsLight);
                    float lightDistance = max(0.0,-along+sqrt(max(0.0,along*along+0.91-dot(pos,pos))));
                    float obstruction = broad;
                    if (detailWeight > 0.10) obstruction = ParticleVolumeNoise(coord + towardsLight*(0.58*lightDistance));
                    float sunlight = exp(-lightDistance*(0.40 + 1.14*obstruction)*inOpticalDepth*0.29);
                    float forwardScatter = 0.12*pow(saturate(dot(ray,towardsLight)),3.0);
                    radiance = tint * (0.29+sunlight*1.04+forwardScatter) * max(glow,0.35);
                }
                else
                {
                    float seam = 1.0-smoothstep(0.03,0.25,abs(noise-0.55));
                    float heat = saturate(0.38 + 0.48*noise + 0.27*core - 0.25*h);
                    if (cap) heat = saturate(0.33+0.42*seam+0.24*core+0.11*noise);
                    float cool = plume ? 0.0 : smoothstep(0.46,0.96,age);
                    float3 warm = lerp(tint,float3(1.0,0.18,0.018),0.43);
                    float3 hot = lerp(warm,float3(1.0,0.74,0.24),smoothstep(0.46,0.94,heat));
                    float3 fading = lerp(warm*float3(0.48,0.19,0.08),float3(0.053,0.031,0.026),cool);
                    radiance = lerp(hot,fading,cool*(cap ? 0.82 : 0.94))*glow*(0.52+0.59*heat);
                    if (wave || radialFront)
                    {
                        float ash = smoothstep(0.32,0.89,age)*(0.42+0.53*noise);
                        radiance = lerp(radiance,float3(0.35,0.22,0.14)*(0.52+0.86*noise),ash);
                    }
                }
                if (radialFront)
                {
                    // Dense folds scatter less light into the view. The gas in the troughs
                    // remains present at every heading even as its temperature falls.
                    if (cloud) radiance *= lerp(0.46,1.26,smoothstep(0.19,0.87,frontFold));
                    else radiance *= lerp(float3(0.46,0.29,0.20),float3(1.23,1.18,1.08),smoothstep(0.17,0.84,frontFold));
                }
                light += transmittance*deltaOpacity*radiance;
                transmittance *= 1.0-deltaOpacity;
                if (transmittance < 0.012) break;
            }
            float integratedAlpha = 1.0-transmittance;
            surface.emissiveLighting = light / max(integratedAlpha,0.001);
            surface.alpha = params.m_opacityFactor * integratedAlpha;
            surface.albedo = float3(0.022,0.013,0.008);
            surface.specularF0 = float3(0,0,0);
            surface.roughnessLinear = 0.97;
            surface.opacityAffectsSpecularFactor = 1.0;
        }
        // Derive fine surface normals from the animated field in world units.
        float3 n = surface.normal;
        float3 dx = ddx(geoData.positionWS);
        float3 dy = ddy(geoData.positionWS);
        float3 tx = cross(dy, n);
        float3 ty = cross(n, dx);
        float determinant = dot(dx, tx);
        float3 gradient = sign(determinant) * (ddx(field) * tx + ddy(field) * ty) / max(0.000001, abs(determinant));
        float strength = style < 2.5 ? 0.020 : 0.006;
        surface.normal = normalize(n - clamp(gradient * strength, -0.22, 0.22));
        surface.roughnessLinear = clamp(surface.roughnessLinear + (0.5 - field) * 0.21, 0.045, 1.0);
        surface.CalculateRoughnessA();
        surface.alpha *= fade;
        // Atom adds emissive radiance after premultiplying diffuse reflectance.
        if (style > 0.5)
        {
            surface.emissiveLighting *= surface.alpha;
        }
        if (style > 10.5)
        {
            clip(surface.alpha - 0.004);
        }
        return surface;
    }
    #include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_LightingEval.azsli>

#elif MATERIALPIPELINE_SHADER_HAS_GEOMETRIC_PIXEL_STAGE

    COMMON_OPTIONS_PARALLAX()

    bool ShouldHandleParallax()   { return false; }
    bool NeedsTangentFrame()      { return false; }

    DepthResult GetDepth(const MaterialParameters params, Texture2D heightmap, sampler mapSampler, float2 uv, float2 uv_ddx, float2 uv_ddy)
    {
        return SampleDepthFromHeightmap(heightmap, mapSampler, uv, uv_ddx, uv_ddy);
    }

    #include <Atom/Feature/Common/Assets/Shaders/Materials/StandardPBR/StandardPBR_PixelGeometryEval.azsli>
    #include "Atom/Feature/Common/Assets/Shaders/Materials/MaterialFunctions/StandardGetAlphaAndClip.azsli"

    void EvaluateSurface(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData, const MaterialParameters params)
    {
        GetAlphaAndClip(params, geoData.uvs);
    }

#else

    // Depth-only and shadow passes: position transform only.
    #define EvaluateVertexGeometry EvaluateVertexGeometry_ParticleMesh

    VsOutput EvaluateVertexGeometry_ParticleMesh(VsInput IN, VsSystemValues SV, const MaterialParameters params)
    {
        ParticleMeshInstanceData instanceData = LoadInstanceData(SV.m_instanceId);
        float4x4 objectToWorld = GetObjectToWorldMatrix(SV);
        float3 worldPosition = ParticleSurfaceWorldPosition(DisplaceParticleVertex(IN.position, IN.normal, IN.uv0, params, instanceData), instanceData, objectToWorld);

        VsOutput OUT;
        OUT.position = mul(GetViewProjectionMatrix(SV), float4(worldPosition, 1.0));
        OUT.m_instanceId = SV.m_instanceId;
        return OUT;
    }

#endif

// ---------------------------------------------------------------------------
// Motion vector pass
// ---------------------------------------------------------------------------
// Outputs motion vectors for temporal effects (motion blur, TAA).
// Particles don't currently store previous-frame position data, so we output
// zero-length motion vectors.  This satisfies the MainPipeline requirement
// without visual artifacts.
#if defined(MATERIALPIPELINE_USES_PREV_VERTEX_POSITION) && MATERIALPIPELINE_USES_PREV_VERTEX_POSITION

    // Override the default EvaluateVertexGeometry (from the #else block above)
    // so MeshMotionVector.azsli's VertexShader entry point resolves to our
    // implementation that outputs worldPosition / worldPosPrev.
    // The generic PixelShader in MeshMotionVector.azsli handles the rest.
    #undef EvaluateVertexGeometry
    #define EvaluateVertexGeometry EvaluateVertexGeometry_ParticleMeshMotion

    VsOutput EvaluateVertexGeometry_ParticleMeshMotion(VsInput IN, VsSystemValues SV, const MaterialParameters params)
    {
        ParticleMeshInstanceData instanceData = LoadInstanceData(SV.m_instanceId);
        float4x4 objectToWorld = GetObjectToWorldMatrix(SV);
        float3 worldPosition = ParticleSurfaceWorldPosition(DisplaceParticleVertex(IN.position, IN.normal, IN.uv0, params, instanceData), instanceData, objectToWorld);

        VsOutput OUT;
        OUT.position = mul(GetViewProjectionMatrix(SV), float4(worldPosition, 1.0));

        // Motion vector pixel shader needs these unconditionally, even though
        // MATERIAL_USES_VERTEX_POSITIONWS is 0 in the motion-vector pipeline.
        OUT.worldPosition = worldPosition;
        OUT.worldPosPrev  = worldPosition; // no previous-frame data for particles

        OUT.m_instanceId = SV.m_instanceId;
        return OUT;
    }

#endif
