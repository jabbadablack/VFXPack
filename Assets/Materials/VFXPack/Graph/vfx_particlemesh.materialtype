{
    "description": "Flowing combustion, vapor, ice, liquid, plasma, shield and cinder surfaces for instanced OpenParticle meshes.",
    "version": 5,
    "versionUpdates": [
        {
            "toVersion": 5
        }
    ],
    "propertyLayout": {
        "propertyGroups": [
            {
                "name": "baseColor",
                "displayName": "Base Color",
                "description": "Properties for configuring the surface reflected color for dielectrics or reflectance values for metals.",
                "properties": [
                    {
                        "name": "color",
                        "displayName": "Color",
                        "description": "Color is displayed as sRGB but the values are stored as linear color.",
                        "type": "Color",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_baseColor"
                        }
                    },
                    {
                        "name": "factor",
                        "displayName": "Factor",
                        "description": "Factor for blending Color and Texture. The behavior depends on Texture Blend Mode. Or if there is no Texture, then this simply scales the Color value.",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_baseColorFactor"
                        }
                    },
                    {
                        "name": "textureBlendMode",
                        "displayName": "Texture Blend Mode",
                        "description": "Selects the equation to use when combining Color, Factor, and Texture.",
                        "type": "Enum",
                        "defaultValue": "Multiply",
                        "connection": {
                            "type": "ShaderOption",
                            "name": "o_baseColorTextureBlendMode"
                        },
                        "enumValues": [
                            "Multiply",
                            "LinearLight",
                            "Lerp",
                            "Overlay"
                        ]
                    },
                    {
                        "name": "textureMap",
                        "displayName": "Texture",
                        "description": "Base color texture map",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_baseColorMap"
                        }
                    },
                    {
                        "name": "textureMapUv",
                        "displayName": "UV",
                        "description": "Base color map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_baseColorMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "useTexture",
                        "displayName": "Use Texture",
                        "description": "Whether to use the texture.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
                    {
                        "type": "UseTexture",
                        "args": {
                            "textureProperty": "textureMap",
                            "useTextureProperty": "useTexture",
                            "dependentProperties": [
                                "textureMapUv",
                                "textureBlendMode"
                            ],
                            "shaderOption": "o_baseColor_useTexture"
                        }
                    }
                ]
            },
            {
                "name": "clearCoat",
                "displayName": "Clear Coat",
                "description": "Properties for configuring gloss clear coat",
                "properties": [
                    {
                        "name": "enable",
                        "displayName": "Enable",
                        "description": "Enable clear coat",
                        "type": "Bool"
                    },
                    {
                        "name": "factor",
                        "displayName": "Factor",
                        "description": "Strength factor for scaling the percentage of effect applied",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatFactor"
                        }
                    },
                    {
                        "name": "influenceMap",
                        "displayName": "    Influence Map",
                        "description": "Strength factor texture",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatInfluenceMap"
                        }
                    },
                    {
                        "name": "influenceMapUv",
                        "displayName": "    UV",
                        "description": "Strength factor map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatInfluenceMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "normalMap",
                        "displayName": "Normal Map",
                        "description": "Normal map for clear coat layer, as top layer material clear coat doesn't affect by base layer normal map",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatNormalMap"
                        }
                    },
                    {
                        "name": "normalMapUv",
                        "displayName": "    UV",
                        "description": "Normal map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatNormalMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "normalStrength",
                        "displayName": "Normal Strength",
                        "description": "Scales the impact of the clear coat normal map",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "max": 2.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatNormalStrength"
                        }
                    },
                    {
                        "name": "roughness",
                        "displayName": "Roughness",
                        "description": "Clear coat layer roughness",
                        "type": "Float",
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatRoughness"
                        }
                    },
                    {
                        "name": "roughnessMap",
                        "displayName": "    Roughness Map",
                        "description": "Texture for defining surface roughness",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatRoughnessMap"
                        }
                    },
                    {
                        "name": "roughnessMapUv",
                        "displayName": "    UV",
                        "description": "Roughness map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_clearCoatRoughnessMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "useInfluenceMap",
                        "displayName": "    Use Texture",
                        "description": "Whether to use the texture, or just default to the Factor value.",
                        "type": "Bool",
                        "defaultValue": true
                    },
                    {
                        "name": "useNormalMap",
                        "displayName": "    Use Texture",
                        "description": "Whether to use the normal map",
                        "type": "Bool",
                        "defaultValue": true
                    },
                    {
                        "name": "useRoughnessMap",
                        "displayName": "    Use Texture",
                        "description": "Whether to use the texture, or just default to the roughness value.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
                    {
                        "type": "Lua",
                        "args": {
                            "file": "Materials/Types/StandardPBR_ClearCoatState.lua"
                        }
                    },
                    {
                        "type": "Lua",
                        "args": {
                            "file": "Materials/Types/StandardPBR_ClearCoatEnableFeature.lua"
                        }
                    }
                ]
            },
            {
                "name": "effect",
                "displayName": "Particle Surface",
                "description": "Mesh surface shaping and animated flow.",
                "properties": [
                    {
                        "name": "edge",
                        "displayName": "Rim falloff",
                        "description": "Rim falloff",
                        "type": "Float",
                        "defaultValue": 1.600000023841858,
                        "min": 0.15000000596046448,
                        "max": 8.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectEdge"
                        }
                    },
                    {
                        "name": "erosion",
                        "displayName": "Erosion threshold",
                        "description": "Erosion threshold",
                        "type": "Float",
                        "defaultValue": 0.3799999952316284,
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectErosion"
                        }
                    },
                    {
                        "name": "flow",
                        "displayName": "Surface flow",
                        "description": "Surface flow",
                        "type": "Float",
                        "min": -3.0,
                        "max": 3.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectFlow"
                        }
                    },
                    {
                        "name": "frequency",
                        "displayName": "Pattern frequency",
                        "description": "Pattern frequency",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.10000000149011612,
                        "max": 6.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectFrequency"
                        }
                    },
                    {
                        "name": "seed",
                        "displayName": "Pattern offset",
                        "description": "Pattern offset",
                        "type": "Float",
                        "min": 0.0,
                        "max": 10.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectSeed"
                        }
                    },
                    {
                        "name": "style",
                        "displayName": "Surface family",
                        "description": "0 neutral, 1 combustion, 2 vapor, 3 crystal, 4 liquid, 5 plasma, 6 energy shield, 7 cinder, 8 beam sheath.",
                        "type": "Float",
                        "min": 0.0,
                        "max": 8.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_effectStyle"
                        }
                    }
                ]
            },
            {
                "name": "emissive",
                "displayName": "Emissive",
                "description": "Properties to add light emission, independent of other lights in the scene.",
                "properties": [
                    {
                        "name": "affectedByAlpha",
                        "displayName": "Affected by alpha",
                        "description": "How much the emissive surface is attenuated by diffuse alpha.",
                        "type": "Float",
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_emissiveAffectedByAlpha"
                        }
                    },
                    {
                        "name": "color",
                        "displayName": "Color",
                        "description": "Color is displayed as sRGB but the values are stored as linear color.",
                        "type": "Color",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_emissiveColor"
                        }
                    },
                    {
                        "name": "enable",
                        "displayName": "Enable",
                        "description": "Enable the emissive group",
                        "type": "Bool"
                    },
                    {
                        "name": "intensity",
                        "displayName": "Intensity",
                        "description": "The amount of energy emitted.",
                        "type": "Float",
                        "defaultValue": 4.0,
                        "min": -10.0,
                        "max": 20.0,
                        "softMin": -6.0,
                        "softMax": 16.0
                    },
                    {
                        "name": "textureMap",
                        "displayName": "Texture",
                        "description": "Texture for defining emissive area.",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_emissiveMap"
                        }
                    },
                    {
                        "name": "textureMapUv",
                        "displayName": "UV",
                        "description": "Emissive map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_emissiveMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "unit",
                        "displayName": "Units",
                        "description": "The photometric units of the Intensity property.",
                        "type": "Enum",
                        "defaultValue": "Ev100",
                        "enumValues": [
                            "Ev100"
                        ]
                    },
                    {
                        "name": "useTexture",
                        "displayName": "Use Texture",
                        "description": "Whether to use the texture.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
                    {
                        "type": "ConvertEmissiveUnit",
                        "args": {
                            "shaderParameters": [
                                {
                                    "name": "m_emissiveIntensity",
                                    "type": "float"
                                }
                            ],
                            "intensityProperty": "intensity",
                            "lightUnitProperty": "unit",
                            "shaderInput": "m_emissiveIntensity",
                            "ev100MinMax": [
                                -10.0,
                                20.0
                            ],
                            "nitMinMax": [
                                0.0010000000474974513,
                                100000.0
                            ]
                        }
                    },
                    {
                        "type": "Lua",
                        "args": {
                            "file": "Materials/Types/StandardPBR_EmissiveState.lua"
                        }
                    }
                ]
            },
            {
                "name": "irradiance",
                "displayName": "Irradiance",
                "description": "Properties for configuring the irradiance used in global illumination.",
                "properties": [
                    {
                        "name": "factor",
                        "displayName": "Factor",
                        "description": "Strength factor for scaling the irradiance color values. Zero (0.0) is black, white (1.0) is full color.",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "max": 1.0
                    },
                    {
                        "name": "irradianceColorSource",
                        "displayName": "Irradiance Color Source",
                        "description": "Where to get the irradiance color from? This color can be automatically derived from the diffuse base color (BaseColor: including average texture color if textured; BaseColorTint: base color only, ignoring texture), or the manually provided color below (Manual).",
                        "type": "Enum",
                        "defaultValue": "Manual",
                        "enumValues": [
                            "BaseColor",
                            "BaseColorTint",
                            "Manual"
                        ]
                    },
                    {
                        "name": "manualColor",
                        "displayName": "Manual Color",
                        "description": "Irradiance color that is used when the Irradiance Color Source is set to 'Manual'. Color is displayed as sRGB but the values are stored as linear color.",
                        "type": "Color"
                    }
                ],
                "functors": [
                    {
                        "type": "Lua",
                        "args": {
                            "file": "Materials/Types/StandardPBR_HandleIrradianceColorSource.lua"
                        }
                    }
                ]
            },
            {
                "name": "metallic",
                "displayName": "Metallic",
                "description": "Properties for configuring whether the surface is metallic or not.",
                "properties": [
                    {
                        "name": "factor",
                        "displayName": "Factor",
                        "description": "This value is linear, black is non-metal and white means raw metal.",
                        "type": "Float",
                        "min": 0.0,
                        "max": 1.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_metallicFactor"
                        }
                    },
                    {
                        "name": "textureMap",
                        "displayName": "Texture",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_metallicMap"
                        }
                    },
                    {
                        "name": "textureMapUv",
                        "displayName": "UV",
                        "description": "Metallic map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_metallicMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "useTexture",
                        "displayName": "Use Texture",
                        "description": "Whether to use the texture, or just default to the Factor value.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
                    {
                        "type": "Lua",
                        "args": {
                            "file": "Materials/Types/StandardPBR_Metallic.lua"
                        }
                    }
                ]
            },
            {
                "name": "normal",
                "displayName": "Normal",
                "description": "Properties related to configuring surface normal.",
                "properties": [
                    {
                        "name": "factor",
                        "displayName": "Factor",
                        "description": "Strength factor for scaling the values",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "softMax": 2.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_normalFactor"
                        }
                    },
                    {
                        "name": "flipX",
                        "displayName": "Flip X Channel",
                        "description": "Flip tangent direction for this normal map.",
                        "type": "Bool",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_flipNormalX"
                        }
                    },
                    {
                        "name": "flipY",
                        "displayName": "Flip Y Channel",
                        "description": "Flip bitangent direction for this normal map.",
                        "type": "Bool",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_flipNormalY"
                        }
                    },
                    {
                        "name": "textureMap",
                        "displayName": "Texture",
                        "description": "Texture for defining surface normal direction.",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_normalMap"
                        }
                    },
                    {
                        "name": "textureMapUv",
                        "displayName": "UV",
                        "description": "Normal map UV set",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_normalMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "useTexture",
                        "displayName": "Use Texture",
                        "description": "Whether to use the texture, or just rely on vertex normals.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
                    {
                        "type": "UseTexture",
                        "args": {
                            "textureProperty": "textureMap",
                            "useTextureProperty": "useTexture",
                            "dependentProperties": [
                                "textureMapUv",
                                "factor",
                                "flipX",
                                "flipY"
                            ],
                            "shaderOption": "o_normal_useTexture"
                        }
                    }
                ]
            },
            {
                "name": "occlusion",
                "displayName": "Occlusion",
                "description": "Properties for baked textures that represent geometric occlusion of light.",
                "properties": [
                    {
                        "name": "diffuseFactor",
                        "displayName": "    Factor",
                        "description": "Strength factor for scaling the values of Diffuse AO",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "softMax": 2.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_diffuseOcclusionFactor"
                        }
                    },
                    {
                        "name": "diffuseTextureMap",
                        "displayName": "Diffuse AO",
                        "description": "Texture for defining occlusion area for diffuse ambient lighting.",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_diffuseOcclusionMap"
                        }
                    },
                    {
                        "name": "diffuseTextureMapUv",
                        "displayName": "    UV",
                        "description": "Diffuse AO map UV set.",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_diffuseOcclusionMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "diffuseUseTexture",
                        "displayName": "    Use Texture",
                        "description": "Whether to use the Diffuse AO map.",
                        "type": "Bool",
                        "defaultValue": true
                    },
                    {
                        "name": "specularFactor",
                        "displayName": "    Factor",
                        "description": "Strength factor for scaling the values of Specular Cavity",
                        "type": "Float",
                        "defaultValue": 1.0,
                        "min": 0.0,
                        "softMax": 2.0,
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_specularOcclusionFactor"
                        }
                    },
                    {
                        "name": "specularTextureMap",
                        "displayName": "Specular Cavity",
                        "description": "Texture for defining occlusion area for specular lighting.",
                        "type": "Image",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_specularOcclusionMap"
                        }
                    },
                    {
                        "name": "specularTextureMapUv",
                        "displayName": "    UV",
                        "description": "Specular Cavity map UV set.",
                        "type": "Enum",
                        "defaultValue": "Tiled",
                        "connection": {
                            "type": "ShaderInput",
                            "name": "m_specularOcclusionMapUvIndex"
                        },
                        "enumValues": [
                            "Tiled",
                            "Unwrapped"
                        ],
                        "enumIsUv": true
                    },
                    {
                        "name": "specularUseTexture",
                        "displayName": "    Use Texture",
                        "description": "Whether to use the Specular Cavity map.",
                        "type": "Bool",
                        "defaultValue": true
                    }
                ],
                "functors": [
